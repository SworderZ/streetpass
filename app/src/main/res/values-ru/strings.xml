    <!-- Настройки: энергопотребление -->
    <string name="section_power">Энергопотребление</string>
    <string name="power_saver_title">Экономия</string>
    <string name="power_saver_desc">8 секунд сканирования каждые 2 минуты. Максимальное время от батареи, но встречи мимоходом могут быть пропущены.</string>
    <string name="power_balanced_title">Баланс</string>
    <string name="power_balanced_desc">10 секунд сканирования каждую минуту. Разумный компромисс для повседневного ношения.</string>
    <string name="power_max_title">Максимум</string>
    <string name="power_max_desc">Непрерывное сканирование. Ничего не пропускает, но заметно расходует батарею.</string>

    <!-- Настройки: антидубль -->
    <string name="section_cooldown">Антидубль</string>
    <string name="cooldown_text">Повторная встреча с тем же человеком засчитывается не раньше, чем через %1$s</string>
    <string name="cooldown_help">Всё это время человек может быть рядом, сигнал будет приниматься, но новая встреча в историю не попадёт. Диапазон: от %1$s до %2$s.</string>

    <!-- Настройки: порог RSSI -->
    <string name="section_rssi">Порог сигнала</string>
    <string name="rssi_text">Не ниже %1$d dBm — %2$s</string>
    <string name="rssi_hint_touch">только вплотную, до полуметра</string>
    <string name="rssi_hint_near">примерно 1–2 метра</string>
    <string name="rssi_hint_room">примерно 3–6 метров, одна комната</string>
    <string name="rssi_hint_far">около 10 метров, соседнее помещение</string>
    <string name="rssi_hint_max">максимальная дальность, включая соседей за стеной</string>
    <string name="rssi_help">Пакеты слабее порога отбрасываются: так не считаются люди за стеной или этажом ниже. Чем ближе к −40, тем ближе должен быть человек. Оценка дистанции приблизительная и зависит от телефона.</string>

