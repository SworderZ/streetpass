    <string name="ble_error_title">Ошибка Bluetooth</string>

    <string name="adv_unsupported_title">Передача недоступна</string>
    <string name="adv_unsupported_text">Bluetooth-чип этого устройства не умеет BLE-рекламу. Вы будете видеть других пользователей, но они вас — нет.</string>

    <string name="notif_denied_title">Уведомления запрещены</string>
    <string name="notif_denied_text">Обнаружение работает и без них, но постоянное уведомление со счётчиком показываться не будет.</string>
    <string name="notif_allow">Разрешить</string>

