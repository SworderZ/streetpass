    <!-- Settings: profile -->
    <string name="section_profile">Profile</string>
    <string name="nickname_label">Nickname</string>
    <string name="nickname_hint">Shown to other users instead of your ID</string>
    <string name="nickname_bytes">%1$d / %2$d bytes</string>
    <string name="nickname_save">Save</string>
    <string name="nickname_warning">The nickname is broadcast in the clear: anyone with a Bluetooth scanner nearby can read it. Leave it empty to stay fully anonymous.</string>

    <!-- Settings: discovery -->
    <string name="section_discovery">Discovery</string>
    <string name="sw_advertise_title">Broadcast my ID</string>
    <string name="sw_advertise_sub">Lets other users count an encounter with you</string>
    <string name="sw_scan_title">Look for others</string>
    <string name="sw_scan_sub">Scan the air and record encounters</string>
    <string name="sw_accept_unsigned_title">Accept unsigned IDs</string>
    <string name="sw_accept_unsigned_sub">Count devices running older versions that do not sign their ID. While this is on, anyone can pose as another person by copying their ID.</string>
    <string name="sw_notify_friends_title">Notify about friends</string>
    <string name="sw_notify_friends_sub">A separate notification when an encounter with a friend is recorded</string>
    <string name="sw_autostart_title">Start after reboot</string>
    <string name="sw_autostart_sub">If discovery was on, bring it back up when the system starts</string>

    <!-- Settings: power -->
    <string name="section_power">Power</string>
    <string name="power_saver_title">Saver</string>
    <string name="power_saver_desc">8 seconds of scanning every 2 minutes. Longest battery life, but passing encounters may be missed.</string>
    <string name="power_balanced_title">Balanced</string>
    <string name="power_balanced_desc">10 seconds of scanning every minute. A sensible compromise for everyday carry.</string>
    <string name="power_max_title">Maximum</string>
    <string name="power_max_desc">Continuous scanning. Misses nothing, noticeably drains the battery.</string>

    <!-- Settings: cooldown -->
    <string name="section_cooldown">Duplicate protection</string>
    <string name="cooldown_text">A repeat encounter with the same person counts no sooner than %1$s later</string>
    <string name="cooldown_help">During that time the person may be nearby and the signal received, but no new encounter is added to the history. Range: %1$s to %2$s.</string>

    <!-- Settings: RSSI -->
    <string name="section_rssi">Signal threshold</string>
    <string name="rssi_text">No weaker than %1$d dBm — %2$s</string>
    <string name="rssi_hint_touch">only up close, within half a metre</string>
    <string name="rssi_hint_near">roughly 1–2 metres</string>
    <string name="rssi_hint_room">roughly 3–6 metres, same room</string>
    <string name="rssi_hint_far">about 10 metres, next room</string>
    <string name="rssi_hint_max">maximum range, including neighbours behind a wall</string>
    <string name="rssi_help">Packets weaker than the threshold are dropped, so people behind a wall or a floor below are not counted. The closer to −40, the closer the person has to be. The distance estimate is rough and depends on the phone.</string>

    <!-- Settings: privacy -->
    <string name="section_privacy">Privacy</string>
    <string name="sw_store_rssi_title">Store signal strength</string>
    <string name="sw_store_rssi_sub">RSSI in the history helps judge how close the person was</string>
    <string name="your_id">Your ID</string>
    <string name="btn_change_id">Change ID</string>
    <string name="btn_clear_history">Clear history</string>
    <string name="dialog_regen_title">Change ID?</string>
    <string name="dialog_regen_text">A new signing key will be created and other users will start seeing you as a new person: at the next encounter they will record a “first meeting”. Your own history is unaffected.</string>
    <string name="dialog_regen_confirm">Change</string>
    <string name="dialog_clear_title">Clear history?</string>
    <string name="dialog_clear_text">All encounters and statistics will be deleted permanently. Friends stay in the list with their counters reset; unlocked achievements are kept. Discovery keeps running.</string>
    <string name="dialog_clear_confirm">Clear</string>
