    <!-- Invites -->
    <string name="invite_title">Invite a friend</string>
    <string name="invite_qr_description">QR code with your invite link</string>
    <string name="invite_text">Let a friend scan this code in StreetPass, or send them the link. If the link does not open by itself, they can share the message to StreetPass or paste it in “Add friend”. The invite contains your ID and nickname, signed with your key — nothing else.</string>
    <string name="invite_share">Share link</string>
    <string name="invite_share_text">Add me as a friend in StreetPass: %1$s\n\nNo app yet? %2$s</string>
    <string name="add_friend_title">Add friend</string>
    <string name="add_friend_scan_hint">Point the camera at a friend’s QR code, or paste an invite link below.</string>
    <string name="add_friend_paste_hint">Paste the invite link below.</string>
    <string name="add_friend_camera_denied">No camera access. You can still add a friend by pasting the invite link.</string>
    <string name="add_friend_allow_camera">Allow camera</string>
    <string name="add_friend_link_label">Invite link</string>
    <string name="add_friend_submit">Add</string>
    <string name="add_friend_link_invalid">This is not a valid StreetPass invite: the link is incomplete or its signature does not match.</string>
    <string name="confirm_invite_title">Add as friend?</string>
    <string name="confirm_invite_text">They will be marked as a friend on this phone only. Encounters with them will be recorded once your phones meet.</string>
    <string name="confirm_invite_self">This is your own invite.</string>
    <string name="confirm_invite_add">Add</string>
