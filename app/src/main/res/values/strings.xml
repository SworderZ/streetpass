    <string name="perm_title">Permissions needed</string>
    <string name="perm_text_legacy">To find other devices over Bluetooth, Android versions before 12 require the location permission. The app does not determine or store your location — this is a system requirement for BLE scanning.</string>
    <string name="perm_text_modern">Broadcasting and scanning over Bluetooth needs the “Nearby devices” permission. Location is not requested.</string>
    <string name="perm_action">Grant permissions</string>

    <string name="bt_off_title">Bluetooth is off</string>
    <string name="bt_off_text">Discovery cannot work without Bluetooth. It will resume on its own once you turn it on.</string>
    <string name="bt_off_action">Open Bluetooth settings</string>

    <string name="ble_error_title">Bluetooth error</string>

    <string name="adv_unsupported_title">Broadcasting unavailable</string>
    <string name="adv_unsupported_text">This device’s Bluetooth chip cannot do BLE advertising. You will see other users, but they will not see you.</string>

    <string name="notif_denied_title">Notifications blocked</string>
    <string name="notif_denied_text">Discovery works without them, but the persistent notification with the counter will not be shown.</string>
